[user]
	name = Ağabey Alioğlu
	email = agabeyalioglu@gmail.com
[http]
	postBuffer = 524288000
[core]
	autocrlf = input
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = gruvbox-dark

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[init]
	defaultBranch = main
